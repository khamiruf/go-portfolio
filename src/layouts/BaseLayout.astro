---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/inter/wght-italic.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/400-italic.css';
import '@fontsource/space-mono/700.css';
import '@fontsource/space-mono/700-italic.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { SECTIONS } from '../lib/notion';

export interface Props {
  title?: string;
  description?: string;
  section?: string;
  type?: 'website' | 'article';
}

const DEFAULT_DESCRIPTION = 'Backend engineer. Reads too much. Occasionally boards a plane.';
const {
  title,
  description = DEFAULT_DESCRIPTION,
  section = 'home',
  type = 'website',
} = Astro.props;
const fullTitle = title ? `${title} — khamiruf` : 'khamiruf';
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-theme="light" data-section={section}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="khamiruf" />
  <meta property="og:title" content={title ?? 'khamiruf'} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <meta name="theme-color" content="#F7F6F1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="khamiruf" href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
  <script is:inline>
    // Runs before first paint so the page never flashes the wrong theme.
    (function() {
      var t;
      try { t = localStorage.getItem('theme'); } catch (e) {}
      if (t !== 'light' && t !== 'dark') {
        t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-theme', t);
      document.querySelector('meta[name="theme-color"]').content = t === 'dark' ? '#15140F' : '#F7F6F1';
    })();
  </script>
</head>
<body>
  <div id="read-progress" aria-hidden="true"></div>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <header class="site-header" id="site-header">
    <a href="/" class="site-name"><span class="site-name-mark" aria-hidden="true"></span>khamiruf</a>
    <nav id="primary-nav" aria-label="Primary">
      <div class="nav-inner">
        {SECTIONS.map((s) => (
          <a href={`/${s}/`} aria-current={section === s ? 'page' : undefined}>{s}</a>
        ))}
      </div>
    </nav>
    <div class="header-controls">
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode">
        <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.41 1.41M11.54 11.54l1.41 1.41M3.05 12.95l1.41-1.41M11.54 4.46l1.41-1.41M11 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M13.5 8.5A5.5 5.5 0 0 1 6 2.2a6 6 0 1 0 7.5 6.3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button class="hamburger" id="hamburger" type="button" aria-label="Open menu"
              aria-expanded="false" aria-controls="primary-nav">
        <span class="ham-line"></span>
        <span class="ham-line"></span>
        <span class="ham-line"></span>
      </button>
    </div>
  </header>
  <main id="main-content">
    <slot />
  </main>
  <footer class="site-footer">
    <div>
      <p>© {year} khamiruf</p>
      <nav class="footer-nav" aria-label="Footer navigation">
        {SECTIONS.map((s) => <a href={`/${s}/`}>{s}</a>)}
        <a href="/rss.xml">rss</a>
      </nav>
    </div>
    <span class="footer-mark" aria-hidden="true">‹ EOF ›</span>
  </footer>
  <button class="back-to-top" id="back-to-top" type="button" aria-label="Back to top">↑</button>

  <script>
    import '../scripts/site';
  </script>
</body>
</html>

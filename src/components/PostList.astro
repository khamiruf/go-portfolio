---
import { hrefFor, dateStart, isoDate, type PostEntry } from '../lib/notion';

export interface Props {
  entries: PostEntry[];
  showDate?: boolean;
  /** Prefix each title with its section (for mixed lists like "Latest"). */
  showSection?: boolean;
}

const { entries, showDate = true, showSection = false } = Astro.props;
const items = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    href: await hrefFor(entry),
    date: isoDate(dateStart(entry.data.properties.Date)),
  })),
);
---

<ul class={`post-list${showDate ? '' : ' post-list--no-date'}`}>
  {items.map(({ entry, href, date }) => {
    const p = entry.data.properties;
    return (
      <li>
        {showDate && <time class="date" datetime={date}>{date}</time>}
        <div class="post-meta">
          <a href={href}>{p.Name}</a>
          {(showSection || (p.Tags && p.Tags.length > 0)) && (
            <span class="tags">
              {showSection && <span class="tag">{p.Section}</span>}
              {p.Tags?.map((tag) => <span class="tag">{tag}</span>)}
            </span>
          )}
        </div>
      </li>
    );
  })}
</ul>

---
import { dateStart, isoDate, prepareHtml, readingStats, type PostEntry } from '../lib/notion';

export interface Props {
  entry: PostEntry;
}

const { entry } = Astro.props;
const p = entry.data.properties;
const html = await prepareHtml(entry.rendered?.html ?? '');
const date = isoDate(dateStart(p.Date));
const { words, minutes } = readingStats(html);
---

<article data-pagefind-body data-pagefind-meta={`section:${p.Section ?? ''}`}>
  <div class="article-header">
    <h1 data-pagefind-ignore>{p.Name}</h1>
    <p class="meta" data-pagefind-ignore data-pagefind-meta={p.Tags?.length ? `tags:${p.Tags.join(' ')}` : undefined}>
      {date && <time datetime={date} data-pagefind-meta="date">{date}</time>}
      {words > 0 && <><span>{words} words</span><span>{minutes} min read</span></>}
      {p.Tags && p.Tags.map((tag) => <span class="tag">{tag}</span>)}
    </p>
  </div>
  <div class="prose" id="post-body" set:html={html} />
</article>

---
import BookCover from './BookCover.astro';
import { bookCover, ratingDots, hrefFor, dateStart, isoDate, type BookEntry } from '../lib/notion';

export interface Props {
  entry: BookEntry;
  /** progress: show % bar (reading). rating: show dots (read). plain: neither. */
  variant?: 'progress' | 'rating' | 'plain';
}

const { entry, variant = 'plain' } = Astro.props;
const p = entry.data.properties;
const cover = await bookCover(entry);
const href = await hrefFor(entry);
const tags = (p.Tags ?? []).join(',');
const read = dateStart(p['Date Read']);
---

<a href={href} class="book-card" data-reveal data-tags={tags}>
  <div class="book-cover">
    <BookCover src={cover} title={p.Name} placeholderClass="cover-placeholder" />
  </div>
  <div class="book-info">
    <p class="book-title">{p.Name}</p>
    <p class="book-author">{p.Author}</p>
    {p.Translator && <p class="book-translator">trans. {p.Translator}</p>}
    {variant === 'progress' && p.Progress ? (
      <>
        <div class="progress-bar" role="progressbar" aria-label={`${p.Name} progress`}
             aria-valuenow={p.Progress} aria-valuemin="0" aria-valuemax="100">
          <div class="progress-fill" style={`width: ${p.Progress}%`}></div>
        </div>
        <span class="progress-label" aria-hidden="true">{p.Progress}%</span>
      </>
    ) : null}
    {variant === 'rating' && p.Rating ? (
      <p class="book-rating" aria-label={`Rated ${p.Rating} out of 5`}>{ratingDots(p.Rating)}</p>
    ) : null}
    {variant === 'rating' && read ? <p class="book-date"><time datetime={isoDate(read)}>{isoDate(read)}</time></p> : null}
  </div>
</a>

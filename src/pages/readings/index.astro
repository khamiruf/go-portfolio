---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/BookCard.astro';
import { dateStart } from '../../lib/notion';

// The Notion loader's content-layer cache can leave previously-synced entries
// in stale positions (it only repositions pages whose last_edited_time
// changed), so re-sort here rather than trusting collection order.
const books = (await getCollection('books')).sort((a, b) => {
  const aDate = dateStart(a.data.properties['Date Read'])?.getTime() ?? -Infinity;
  const bDate = dateStart(b.data.properties['Date Read'])?.getTime() ?? -Infinity;
  return bDate - aDate;
});
const byStatus = (s: string) => books.filter((b) => b.data.properties.Status === s);
const reading = byStatus('reading');
const read = byStatus('read');
const want = byStatus('want-to-read');

const counts = new Map<string, number>();
for (const b of books) {
  for (const tag of b.data.properties.Tags ?? []) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = [...counts.keys()].sort();
---

<BaseLayout
  title="Readings"
  description="Books I am reading, have read, and want to read — with notes."
  section="readings"
>
  <div class="page-heading-row">
    <h1 class="page-heading">Books</h1>
    <span class="page-heading-meta">{books.length} {books.length === 1 ? 'entry' : 'entries'}</span>
  </div>

  {tags.length > 0 && (
    <div class="tag-filters">
      <label class="tag-filter-label" for="tag-select">filter</label>
      <select id="tag-select" class="tag-select">
        <option value="all">all</option>
        {tags.map((tag) => <option value={tag}>{tag} ({counts.get(tag)})</option>)}
      </select>
    </div>
  )}

  {reading.length > 0 && (
    <section class="books-section" data-section="reading">
      <p class="section-label">Reading<span class="section-count">{reading.length}</span></p>
      <div class="book-grid">
        {reading.map((entry) => <BookCard entry={entry} variant="progress" />)}
      </div>
    </section>
  )}

  {read.length > 0 && (
    <section class="books-section" data-section="read">
      <p class="section-label">Read<span class="section-count">{read.length}</span></p>
      <div class="book-grid">
        {read.map((entry) => <BookCard entry={entry} variant="rating" />)}
      </div>
    </section>
  )}

  <section class="books-section" data-section="want">
    <p class="section-label">Want to read<span class="section-count">{want.length}</span></p>
    {want.length > 0 ? (
      <ul class="want-list">
        {want.map((entry) => {
          const p = entry.data.properties;
          return (
            <li data-reveal data-tags={(p.Tags ?? []).join(',')}>
              <span class="book-title">{p.Name}</span>
              <span class="book-author">{p.Author}</span>
              {p.Translator && <span class="book-translator">trans. {p.Translator}</span>}
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="muted">Nothing queued up. This won't last long.</p>
    )}
  </section>

  <script>
    const sel = document.getElementById('tag-select') as HTMLSelectElement | null;

    function applyFilter(tag: string) {
      sel!.value = tag;
      const all = tag === 'all';
      document.querySelectorAll<HTMLElement>('.book-card, .want-list li').forEach((el) => {
        el.hidden = !all && !(el.dataset.tags ?? '').split(',').includes(tag);
      });
      document.querySelectorAll<HTMLElement>('.books-section').forEach((section) => {
        section.hidden = !section.querySelector('.book-card:not([hidden]), .want-list li:not([hidden])');
      });
    }

    if (sel) {
      sel.addEventListener('change', () => {
        applyFilter(sel.value);
        // Keep the filter in the URL so it can be shared and survives back/forward.
        const url = new URL(location.href);
        if (sel.value === 'all') url.searchParams.delete('tag');
        else url.searchParams.set('tag', sel.value);
        history.replaceState(null, '', url);
      });

      const initial = new URLSearchParams(location.search).get('tag');
      if (initial && [...sel.options].some((o) => o.value === initial)) applyFilter(initial);
    }
  </script>
</BaseLayout>

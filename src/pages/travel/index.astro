---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';

const posts = (await getCollection('posts')).filter(
  (p) => p.data.properties.Section === 'travel',
);
---

<BaseLayout title="Travel" section="travel">
  <div class="page-heading-row">
    <h1 class="page-heading">Travel</h1>
    <span class="page-heading-meta">{posts.length} {posts.length === 1 ? 'entry' : 'entries'}</span>
  </div>
  {posts.length > 0 ? (
    <PostList entries={posts} section="travel" />
  ) : (
    <p class="muted">Haven't gone anywhere recently. Or have I.</p>
  )}
</BaseLayout>

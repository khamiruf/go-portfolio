---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';

const posts = (await getCollection('posts')).filter(
  (p) => p.data.properties.Section === 'projects',
);
---

<BaseLayout title="Projects" section="projects">
  <div class="page-heading-row">
    <h1 class="page-heading">Projects</h1>
    <span class="page-heading-meta">{posts.length} {posts.length === 1 ? 'entry' : 'entries'}</span>
  </div>
  {posts.length > 0 ? (
    <PostList entries={posts} section="projects" />
  ) : (
    <p class="muted">No projects yet. Either busy thinking or watching football.</p>
  )}
</BaseLayout>

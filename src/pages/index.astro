---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import PostList from '../components/PostList.astro';
import { POST_SECTIONS, dateStart } from '../lib/notion';

const books = await getCollection('books');
const latest = (await getCollection('posts'))
  .filter((p) => (POST_SECTIONS as readonly string[]).includes(p.data.properties.Section ?? ''))
  .sort(
    (a, b) =>
      (dateStart(b.data.properties.Date)?.getTime() ?? -Infinity) -
      (dateStart(a.data.properties.Date)?.getTime() ?? -Infinity),
  )
  .slice(0, 5);
const reading = books.filter((b) => b.data.properties.Status === 'reading');

const index = [
  { slug: 'readings', label: 'Readings', swatch: 'var(--lavender)' },
  { slug: 'projects', label: 'Projects', swatch: 'var(--mint)' },
  { slug: 'learnings', label: 'Learnings', swatch: 'var(--yellow)' },
  { slug: 'travel', label: 'Travel', swatch: 'var(--blue)' },
];
---

<BaseLayout
  section="home"
  description="Backend engineer. Reads too much. Occasionally boards a plane. Notes on books, projects, learnings and travel."
>
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-main">
        <p class="eyebrow">PORTFOLIO</p>
        <h1 class="intro-headline">Unintentionally<br />human.</h1>
        <p class="intro-body">
          Backend engineer. Reads too much. Occasionally boards a plane.
        </p>
      </div>
      <div class="index-panel">
        <p class="panel-label">Index</p>
        <ul class="index-list">
          {index.map((item, i) => (
            <li>
              <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
              <a href={`/${item.slug}/`}>{item.label}</a>
              <span class="index-swatch" style={`background:${item.swatch}`} aria-hidden="true"></span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {reading.length > 0 && (
    <section class="currently-reading">
      <p class="section-label">Currently reading<span class="section-count">{reading.length} in progress</span></p>
      <div class="book-grid">
        {reading.map((entry) => <BookCard entry={entry} variant="progress" />)}
      </div>
    </section>
  )}

  {latest.length > 0 && (
    <section class="latest">
      <p class="section-label">Latest</p>
      <PostList entries={latest} showSection />
    </section>
  )}
</BaseLayout>

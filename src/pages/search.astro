---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search books, projects, learnings and travel notes." section="search">
  <div class="page-heading-row">
    <h1 class="page-heading">Search</h1>
  </div>

  <form class="search-form" role="search" action="/search/" method="get">
    <label class="search-label" for="search-input">Search the site</label>
    <input id="search-input" class="search-input" type="search" name="q"
           placeholder="books, authors, places, ideas…" autocomplete="off" spellcheck="false" />
  </form>

  <p class="muted search-status" id="search-status" role="status"></p>
  <ul class="post-list post-list--no-date search-results" id="search-results"></ul>
  <noscript><p class="muted">Search needs JavaScript. Browse by section instead.</p></noscript>

  <script>
    type PagefindResult = {
      url: string;
      excerpt: string;
      meta: { title?: string; section?: string; author?: string; date?: string };
    };
    type PagefindSearch = { results: { data: () => Promise<PagefindResult> }[] };
    type Pagefind = {
      init: () => Promise<void>;
      // Resolves to null when a newer call supersedes this one.
      debouncedSearch: (term: string, options?: object, timeoutMs?: number) => Promise<PagefindSearch | null>;
    };

    const MAX_RESULTS = 20;
    const form = document.querySelector<HTMLFormElement>('.search-form')!;
    const input = document.getElementById('search-input') as HTMLInputElement;
    const status = document.getElementById('search-status')!;
    const list = document.getElementById('search-results')!;

    // Generated by `pagefind` after `astro build`, so it only exists in the
    // build output (not under `astro dev`). The variable keeps Vite from trying
    // to bundle it.
    const bundle = '/pagefind/pagefind.js';
    let pagefind: Promise<Pagefind> | undefined;
    const loadPagefind = (): Promise<Pagefind> => (pagefind ??= import(/* @vite-ignore */ bundle));

    /**
     * Pagefind escapes `<` and `>` in excerpts but not `&`, so treat the excerpt
     * as untrusted: parse it inertly and keep only text and its <mark> highlights.
     */
    function excerptNodes(html: string): Node[] {
      const parsed = document.createElement('template');
      parsed.innerHTML = html;
      return [...parsed.content.childNodes].map((node) => {
        if (node instanceof HTMLElement && node.tagName === 'MARK') {
          const mark = document.createElement('mark');
          mark.textContent = node.textContent;
          return mark;
        }
        return document.createTextNode(node.textContent ?? '');
      });
    }

    function renderResult(r: PagefindResult): HTMLLIElement {
      const li = document.createElement('li');
      const meta = document.createElement('div');
      meta.className = 'post-meta';

      const link = document.createElement('a');
      link.href = r.url;
      link.textContent = r.meta.title || r.url;
      meta.append(link);

      const byline = [r.meta.author, r.meta.date].filter(Boolean).join(' · ');
      if (byline) {
        const p = document.createElement('span');
        p.className = 'search-byline';
        p.textContent = byline;
        meta.append(p);
      }

      const excerpt = document.createElement('p');
      excerpt.className = 'search-excerpt';
      excerpt.append(...excerptNodes(r.excerpt));
      meta.append(excerpt);

      if (r.meta.section) {
        const tags = document.createElement('span');
        tags.className = 'tags';
        const tag = document.createElement('span');
        tag.className = 'tag';
        tag.textContent = r.meta.section;
        tags.append(tag);
        meta.append(tags);
      }

      li.append(meta);
      return li;
    }

    async function run(term: string) {
      // Keep the query in the URL so results can be shared and survive back/forward.
      const url = new URL(location.href);
      if (term) url.searchParams.set('q', term);
      else url.searchParams.delete('q');
      history.replaceState(null, '', url);

      if (!term) {
        status.textContent = '';
        list.replaceChildren();
        return;
      }

      let total: number;
      let results: PagefindResult[];
      try {
        const search = await (await loadPagefind()).debouncedSearch(term, {}, 200);
        // null: a newer keystroke superseded this search.
        if (search === null) return;
        total = search.results.length;
        results = await Promise.all(search.results.slice(0, MAX_RESULTS).map((r) => r.data()));
      } catch {
        pagefind = undefined; // allow a retry on the next keystroke
        if (input.value.trim() !== term) return;
        list.replaceChildren();
        status.textContent = 'Search is unavailable right now.';
        return;
      }
      // A newer search may have finished while fragments were loading.
      if (input.value.trim() !== term) return;

      list.replaceChildren(...results.map(renderResult));
      status.textContent =
        total === 0
          ? `Nothing found for “${term}”.`
          : total > MAX_RESULTS
            ? `Top ${MAX_RESULTS} of ${total} results for “${term}”.`
            : `${total} ${total === 1 ? 'result' : 'results'} for “${term}”.`;
    }

    input.addEventListener('input', () => run(input.value.trim()));
    // Enter shouldn't reload the page; results are already live.
    form.addEventListener('submit', (e) => e.preventDefault());

    const initial = new URLSearchParams(location.search).get('q')?.trim() ?? '';
    if (initial) {
      input.value = initial;
      run(initial);
    } else {
      input.focus();
    }
    // Start fetching the index while the user types their first word.
    loadPagefind()
      .then((pf) => pf.init())
      .catch(() => {});
  </script>
</BaseLayout>
